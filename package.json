{
  "name": "prosemirror-inspector-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Development workspace for ProseMirror Inspector and its TanStack Devtools demo.",
  "license": "MIT",
  "author": {
    "name": "Riccardo Perra",
    "url": "https://github.com/riccardoperra"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardoperra/prosemirror-devtools.git"
  },
  "homepage": "https://github.com/riccardoperra/prosemirror-devtools#readme",
  "bugs": "https://github.com/riccardoperra/prosemirror-devtools/issues",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "build:package": "pnpm --filter prosemirror-inspector run build",
    "check": "pnpm build && pnpm test",
    "changeset": "changeset",
    "changeset:status": "changeset status --since=main",
    "ci:publish": "changeset publish",
    "ci:version": "changeset version",
    "dev": "pnpm --filter prosemirror-inspector run build && pnpm --parallel --filter prosemirror-inspector --filter './packages/*-demo' run dev",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "release": "pnpm build:package && pnpm --filter prosemirror-inspector run publint && pnpm ci:publish",
    "test": "pnpm --recursive --if-present run test",
    "typecheck": "pnpm --filter prosemirror-inspector run build && pnpm --recursive --if-present run typecheck",
    "version-packages": "pnpm ci:version"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
