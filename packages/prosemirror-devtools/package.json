{
  "name": "prosemirror-devtools",
  "version": "0.0.0",
  "description": "Compact, multi-instance ProseMirror developer tools with transaction and plugin performance profiling.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./performance": {
      "types": "./dist/performance.d.ts",
      "default": "./dist/performance.js"
    },
    "./styles": {
      "types": "./dist/styles/index.d.ts",
      "default": "./dist/styles/index.js"
    },
    "./styles.css": "./dist/prosemirror-devtools.css",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/production": {
      "types": "./dist/react/production/index.d.ts",
      "default": "./dist/react/production/index.js"
    },
    "./preact": {
      "types": "./dist/preact/index.d.ts",
      "default": "./dist/preact/index.js"
    },
    "./preact/production": {
      "types": "./dist/preact/production/index.d.ts",
      "default": "./dist/preact/production/index.js"
    },
    "./solid": {
      "types": "./dist/solid/index.d.ts",
      "default": "./dist/solid/index.js"
    },
    "./solid/production": {
      "types": "./dist/solid/production/index.d.ts",
      "default": "./dist/solid/production/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "default": "./dist/vue/index.js"
    },
    "./vue/production": {
      "types": "./dist/vue/production/index.d.ts",
      "default": "./dist/vue/production/index.js"
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "default": "./dist/svelte/index.js"
    },
    "./svelte/production": {
      "types": "./dist/svelte/production/index.d.ts",
      "default": "./dist/svelte/production/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./angular/production": {
      "types": "./dist/angular/production/index.d.ts",
      "default": "./dist/angular/production/index.js"
    },
    "./tiptap": {
      "types": "./dist/tiptap.d.ts",
      "default": "./dist/tiptap.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test",
    "publint": "publint"
  },
  "keywords": [
    "prosemirror",
    "tiptap",
    "devtools",
    "tanstack",
    "performance",
    "editor",
    "debugging"
  ],
  "author": "Riccardo Perra",
  "license": "MIT",
  "dependencies": {
    "@tanstack/devtools-utils": "catalog:",
    "solid-js": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/riccardoperra/prosemirror-devtools.git",
    "directory": "packages/prosemirror-devtools"
  },
  "homepage": "https://github.com/riccardoperra/prosemirror-devtools#readme",
  "bugs": "https://github.com/riccardoperra/prosemirror-devtools/issues",
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@tanstack/react-devtools": ">=0.7.0",
    "preact": ">=10.0.0",
    "prosemirror-model": ">=1.19.0",
    "prosemirror-state": ">=1.4.0",
    "prosemirror-view": ">=1.31.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "svelte": ">=5.0.0",
    "vue": ">=3.2.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@tanstack/react-devtools": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "preact": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/core": "catalog:",
    "@tanstack/charts": "catalog:",
    "@tanstack/solid-charts": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/d3-scale": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "d3-scale": "catalog:",
    "jsdom": "catalog:",
    "prosemirror-model": "catalog:",
    "prosemirror-state": "catalog:",
    "prosemirror-view": "catalog:",
    "publint": "catalog:",
    "preact": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "unplugin-solid": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:"
  }
}
